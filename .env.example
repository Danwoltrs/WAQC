# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Azure AD Authentication (SPA Configuration)
# New app registration: "Wolthers QC System"
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=0cb5605e-296c-426d-bbba-dd6d6582fe33
NEXT_PUBLIC_AZURE_AD_TENANT_ID=b8218f6f-5191-4a79-8937-fac3bd38ee1c
# Note: Client secret is NOT needed for SPA (Single-Page Application) authentication

# NextJS Configuration
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
# Scheduled lab activity digest (see src/lib/reports/lab-activity-routes.ts)
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/lab-activity-report.
CRON_SECRET=generate_a_long_random_string
# Recipient of the digest (the house CC wolthers@wolthers.com is always added).
LAB_ACTIVITY_REPORT_TO=trading@wolthers.com
# 'weekly' (previous Mon–Sun; vercel.json schedule "0 11 * * 1") or
# 'monthly' (previous calendar month; change the schedule to "0 11 1 * *").
LAB_ACTIVITY_REPORT_CADENCE=weekly
# 'pss_approved_ss_rejected' (PSS approved / SS rejected / deleted) or 'full' (both types, both outcomes).
LAB_ACTIVITY_REPORT_BREAKDOWN=pss_approved_ss_rejected
